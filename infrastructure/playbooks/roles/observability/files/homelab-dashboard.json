          "expr": "max by(instance) (node_hwmon_temp_celsius{chip=~\"coretemp.*|cpu.*|soc.*\"} or node_thermal_zone_temp{type=~\"cpu-thermal|soc-thermal|x86_pkg_temp\"} or node_hwmon_temp_celsius)",
